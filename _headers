/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade
  Permissions-Policy: geolocation=(self), microphone=(), camera=()
  Cache-Control: public, max-age=3600

/admin/*
  Cache-Control: no-store, max-age=0

# Kalkyleoppdateringar skal ikkje bli sitjande i Safari-cache.
/kalkyle/*
  Cache-Control: no-store, max-age=0, must-revalidate

/config.js
  Cache-Control: no-store, max-age=0

/tjenester/broyting-pris-info.html
  Link: <https://sorgulen.no/tjenester/broyting-pris-info.html>; rel="canonical"

/tjenester/dekkskift-pris-info.html
  Link: <https://sorgulen.no/tjenester/dekkskift-pris-info.html>; rel="canonical"

/tjenester/diverse-pris-info.html
  Link: <https://sorgulen.no/tjenester/diverse-pris-info.html>; rel="canonical"

/tjenester/takrennevask-pris-info.html
  Link: <https://sorgulen.no/tjenester/takrennevask-pris-info.html>; rel="canonical"

/tjenester/dunkvask-pris-info.html
  Link: <https://sorgulen.no/tjenester/dunkvask-pris-info.html>; rel="canonical"


/maintenance.js
  Cache-Control: no-store, max-age=0

# Berre den eksisterande admin-kundeportalen kan visast inne i oppdragsvisninga.
/admin/kundeportal.html
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Cache-Control: no-store, max-age=0
